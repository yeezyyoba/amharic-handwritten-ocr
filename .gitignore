# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.env
.mypy_cache/
.pytest_cache/

# ===== Node / React Native =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
